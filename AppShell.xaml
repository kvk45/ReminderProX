<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="ReminderProX.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ReminderProX.Views"
       Title="ReminderProX"
       FlyoutBehavior="Flyout"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
       Shell.TabBarForegroundColor="#2196F3"
       Shell.TabBarTitleColor="#2196F3"
       Shell.TabBarUnselectedColor="#757575">
    <Shell.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="FlyoutItemTemplate">
                <Border Margin="10,4" Padding="12,10" StrokeShape="RoundRectangle 12" Stroke="#2196F3" StrokeThickness="2">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="#1E2196F3" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Source="{Binding Icon}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Margin="6,0"/>
                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E1E1E, Dark=#FFFFFF}" VerticalOptions="Center" Margin="12,0"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Shell.Resources>
    <Shell.ItemTemplate>
        <StaticResource Key="FlyoutItemTemplate" />
    </Shell.ItemTemplate>
    <Shell.FlyoutHeader>
        <VerticalStackLayout>
            <Grid BackgroundColor="#2196F3" HeightRequest="140" Padding="20">
                <VerticalStackLayout VerticalOptions="Center">
                    <Image Source="dotnet_bot.png" HeightRequest="60" WidthRequest="60" HorizontalOptions="Start" />
                    <Label Text="ReminderProX" TextColor="White" FontSize="20" FontAttributes="Bold" Margin="0,8,0,0"/>
                </VerticalStackLayout>
            </Grid>
            <Border Margin="10,10,10,4" Padding="12,8" StrokeShape="RoundRectangle 12" Stroke="#2196F3" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                        <Label Text="🌙" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="Dark Mode" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1E1E1E, Dark=#FFFFFF}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Switch x:Name="ThemeSwitch" Grid.Column="1" Toggled="OnThemeSwitchToggled" VerticalOptions="Center"/>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>
    <TabBar>
        <Tab Title="Home" Icon="icon_home.png">
            <ShellContent Title="Home" ContentTemplate="{DataTemplate views:HomePage}" Route="HomePage" />
        </Tab>
        <Tab Title="Ledger" Icon="icon_ledger.png">
            <ShellContent Title="Ledger" ContentTemplate="{DataTemplate views:LedgerPage}" Route="LedgerPage" />
        </Tab>
        <Tab Title="Settings" Icon="icon_settings.png">
            <ShellContent Title="Settings" ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
        </Tab>
    </TabBar>
    <MenuItem Text="Home" IconImageSource="icon_home.png" Clicked="OnHomeClicked" />
    <MenuItem Text="Reminders" IconImageSource="icon_contact_picker.png" Clicked="OnRemindersClicked" />
    <MenuItem Text="Mobile Recharge" IconImageSource="operator_jio.png" Clicked="OnMobileClicked" />
    <MenuItem Text="DTH Recharge" IconImageSource="dth_tataplay.png" Clicked="OnDTHClicked" />
    <MenuItem Text="Ledger" IconImageSource="icon_ledger.png" Clicked="OnLedgerClicked" />
    <MenuItem Text="Settings" IconImageSource="icon_settings.png" Clicked="OnSettingsClicked" />
</Shell>
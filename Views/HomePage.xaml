<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ReminderProX.Controls"
             xmlns:models="clr-namespace:ReminderProX.Models"
             xmlns:viewmodels="clr-namespace:ReminderProX.ViewModels"
             x:Class="ReminderProX.Views.HomePage"
             x:DataType="viewmodels:HomePageViewModel"
             Title="{Binding Title}"
             BackgroundColor="{AppThemeBinding Light=#F8F9FA, Dark=#121212}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Refresh" Command="{Binding RefreshCommand}" IconImageSource="icon_refresh.png" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, *">
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" ColumnSpacing="8" Padding="16,12,16,8">
            <SearchBar Grid.Column="0"
                       Placeholder="Search by Name, Number or ID..."
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       SearchCommand="{Binding SearchCommand}"
                       VerticalOptions="Center" />

            <ImageButton x:Name="AddButton"
                         Grid.Column="1"
                         Source="icon_plus.png"
                         Clicked="OnAddButtonClicked"
                         CornerRadius="8"
                         WidthRequest="46"
                         HeightRequest="46"
                         BackgroundColor="LightSkyBlue"
                         Padding="10"
                         Aspect="AspectFit"
                         VerticalOptions="Center" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <Grid Padding="16,4,16,16">
                <CollectionView x:Name="RemindersCollection"
                                ItemsSource="{Binding FilteredReminders}"
                                RemainingItemsThreshold="3"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreRemindersCommand}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,50">
                            <Label Text="📋" FontSize="44" HorizontalOptions="Center"/>
                            <Label Text="No Reminders Available" FontSize="14" TextColor="Gray" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ReminderCardModel">
                            <controls:RechargeCardView Item="{Binding .}"
                                                       EditCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomePageViewModel}}, Path=EditReminderCommand}"
                                                       DeleteCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomePageViewModel}}, Path=DeleteReminderCommand}"
                                                       CallCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomePageViewModel}}, Path=CallReminderCommand}"
                                                       CopyCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomePageViewModel}}, Path=CopyReminderCommand}"
                                                       WhatsAppCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:HomePageViewModel}}, Path=SendWhatsAppReminderCommand}" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </RefreshView>
    </Grid>
</ContentPage>
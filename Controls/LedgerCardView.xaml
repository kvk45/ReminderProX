<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:ReminderProX.Controls"
             xmlns:models="clr-namespace:ReminderProX.Models"
             x:Class="ReminderProX.Controls.LedgerCardView"
             x:Name="LedgerRoot"
             x:DataType="controls:LedgerCardView">
    <SwipeView Margin="0,4,0,8">
        <SwipeView.RightItems>
            <SwipeItems Mode="Reveal">
                <SwipeItem Text="Delete"
                           IconImageSource="icon_delete.png"
                           Command="{Binding DeleteCommand, Source={x:Reference LedgerRoot}}"
                           CommandParameter="{Binding Item, Source={x:Reference LedgerRoot}}" />
            </SwipeItems>
        </SwipeView.RightItems>
        <Border StrokeShape="RoundRectangle 12"
                Stroke="#2196F3"
                StrokeThickness="1"
                Padding="14"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenCommand, Source={x:Reference LedgerRoot}}"
                                      CommandParameter="{Binding Item, Source={x:Reference LedgerRoot}}" />
            </Border.GestureRecognizers>
            <FlyoutBase.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Delete"
                                    IconImageSource="icon_delete.png"
                                    Command="{Binding DeleteCommand, Source={x:Reference LedgerRoot}}"
                                    CommandParameter="{Binding Item, Source={x:Reference LedgerRoot}}" />
                </MenuFlyout>
            </FlyoutBase.ContextFlyout>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="{Binding Item.UserName, Source={x:Reference LedgerRoot}}"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Text="{Binding Item.CreatedDateTime, Source={x:Reference LedgerRoot}, Converter={StaticResource DateTimeFormatConverter}}"
                           FontSize="12"
                           TextColor="Gray" />
                </VerticalStackLayout>
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{Binding Item.Balance, Source={x:Reference LedgerRoot}, Converter={StaticResource BalanceToBadgeColorConverter}}"
                        StrokeThickness="0"
                        Padding="10,6"
                        VerticalOptions="Center">
                    <Label Text="{Binding Item.Balance, Source={x:Reference LedgerRoot}, Converter={StaticResource BalanceFormatConverter}}"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="15" />
                </Border>
            </Grid>
        </Border>
    </SwipeView>
</ContentView>